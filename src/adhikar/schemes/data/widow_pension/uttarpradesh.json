
{
  "schema_version": "1.0.0",
  "scheme_id": "nirashrit_mahila_pension_uttar_pradesh",

  "name": {
    "en": "Uttar Pradesh Destitute Women Pension Scheme",
    "hi": "उत्तर प्रदेश निराश्रित महिला पेंशन योजना"
  },

  "jurisdiction": {
    "level": "state",
    "state": "Uttar Pradesh",
    "country": "IN"
  },

  "description": {
    "en": "A Uttar Pradesh social security pension scheme providing financial assistance to eligible widowed and destitute women."
  },

  "benefits": {
    "monthly_pension": {
      "amount": 1000,
      "currency": "INR",
      "frequency": "monthly",
      "payment_method": "DBT",
      "reported_disbursement_cycle": "quarterly",
      "reported_quarterly_amount": 3000,
      "verification_status": "needs_review",
      "source_ids": [
        "UP-WIDOW-PENSION-BENEFIT"
      ],
      "note": "₹1,000 per month and quarterly disbursement are reported figures. Confirm the current sanctioned rate and payment schedule through an official government order or SSPY portal."
    },

    "proposed_revised_pension": {
      "amount": 1500,
      "currency": "INR",
      "frequency": "monthly",
      "status": "proposed_or_unconfirmed",
      "verification_status": "needs_review",
      "source_ids": [
        "UP-WIDOW-PENSION-NEWS-2026"
      ],
      "note": "Do not present this amount as an approved entitlement without an official notification."
    },

    "payment_information": {
      "method": "Direct Benefit Transfer",
      "destination": "Beneficiary bank account",
      "verification_status": "needs_review"
    }
  },

  "eligibility_rules": [
    {
      "rule_id": "UP-WIDOW-AGE-01",
      "field": "age_years",
      "operator": "greater_than_or_equal",
      "value": 18,
      "verification_status": "verified",
      "source_ids": [
        "UP-WOMEN-WELFARE"
      ]
    },

    {
      "rule_id": "UP-WIDOW-STATUS-01",
      "field": "marital_status",
      "operator": "equals",
      "value": "widowed",
      "verification_status": "verified",
      "source_ids": [
        "UP-WOMEN-WELFARE"
      ]
    },

    {
      "rule_id": "UP-WIDOW-RESIDENCY-01",
      "field": "state_residency",
      "operator": "equals",
      "value": "Uttar Pradesh",
      "verification_status": "verified",
      "source_ids": [
        "UP-WOMEN-WELFARE"
      ]
    },

    {
      "rule_id": "UP-WIDOW-INCOME-01",
      "field": "annual_family_income_inr",
      "operator": "less_than_or_equal",
      "value": 200000,
      "verification_status": "verified",
      "source_ids": [
        "UP-WOMEN-WELFARE"
      ],
      "note": "Combined annual family income from all sources must not exceed ₹2,00,000."
    },

    {
      "rule_id": "UP-WIDOW-OTHER-PENSION-01",
      "field": "receives_other_government_pension",
      "operator": "equals",
      "value": false,
      "verification_status": "verified",
      "source_ids": [
        "UP-WOMEN-WELFARE"
      ],
      "note": "Applicant must not receive another pension benefit from the State or Central Government, subject to the operative scheme rules."
    }
  ],

  "required_information": [
    "age_years",
    "marital_status",
    "state_residency",
    "annual_family_income_inr",
    "receives_other_government_pension"
  ],

